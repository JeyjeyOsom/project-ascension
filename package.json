{
  "name": "project-ascension",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && npm run lint:api",
    "lint:api": "ruff check apps/api",
    "format": "prettier --write --ignore-unknown . && black apps/api",
    "format:check": "prettier --check --ignore-unknown . && black --check apps/api",
    "check-types": "turbo run check-types && npm run check-types:api",
    "check-types:api": "mypy apps/api",
    "test:api": "pytest apps/api/tests"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "10.9.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
